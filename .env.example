# Copy to .env.local (development), or set these in the staging / production environment.
# Only NEXT_PUBLIC_* values reach the browser. Everything else stays on the server.

# "mock" runs every service against the in-browser sample data (no backend needed).
# "live" sends every service call through /api/backend to CRM_API_BASE_URL.
NEXT_PUBLIC_API_MODE=mock

# Server only. Base URL of the existing CRM/CAM backend, e.g. https://api.cicod.com/crm
# TODO: confirm the staging and production URLs from the Angular environment files.
CRM_API_BASE_URL=

# Server only. Secret used to sign the session cookie. Use a long random value per environment.
SESSION_SECRET=change-me-to-a-long-random-string

# Server only. Session lifetime in minutes before the user must sign in again.
SESSION_TTL_MINUTES=480

# Mock mode only: the password every active sample user signs in with.
MOCK_LOGIN_PASSWORD=cicod-demo
